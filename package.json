{
  "name": "4okimi7uki-cf-page",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build:css": "tailwindcss -i ./src/style/global.css -o ./public/style.css",
    "copy:terminal": "cp node_modules/terminal-demo/dist/index.js public/js/terminal-demo.js && cp node_modules/terminal-demo/dist/style.css public/css/terminal-demo.css",
    "dev:css": "tailwindcss -i ./src/style/global.css -o ./public/style.css --watch",
    "dev": "wrangler dev",
    "dev:all": "concurrently --names \"wrangler,tailwind\" \"pnpm dev\" \"pnpm dev:css\"",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "dayjs": "^1.11.21",
    "hono": "^4.12.29",
    "microcms-js-sdk": "^3.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.1",
    "wrangler": "^4.110.0"
  }
}
